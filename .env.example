# --- Supabase Postgres connection ---
# From Supabase dashboard: Project Settings > Database > Connection string
# Pooled connection (via Supavisor/pgbouncer, port 6543) - used by the app at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used by Prisma Migrate, bypasses the pooler
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase client (used starting Phase 5 for realtime subscriptions) ---
# From Supabase dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed script passwords for the 3 staff logins ---
# If unset, the seed script falls back to a default and prints a warning - change these before seeding.
SEED_OWNER_PASSWORD="ChangeMe123!"
SEED_WAITER_PASSWORD="ChangeMe123!"
SEED_CHEF_PASSWORD="ChangeMe123!"
